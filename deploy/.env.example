# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- Public hostnames (DNS A/AAAA records must point at this server) -------
APP_DOMAIN=attendance.example.com      # HR dashboard
ADMS_DOMAIN=adms.example.com           # what the MB10-VL connects to
ACME_EMAIL=it-admin@example.com        # Let's Encrypt expiry notices

# --- Database (internal only; never published) ----------------------------
POSTGRES_USER=adms
POSTGRES_DB=adms
# Use hex (letters a-f and digits) so it is safe inside the connection URL.
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32

# --- Sessions --------------------------------------------------------------
SESSION_TTL=12h

# --- What devices are told to connect to (shown on the Devices page) -------
ADMS_PUBLIC_PORT=443
ADMS_PUBLIC_HTTPS=true

# --- ADMS protocol profile -------------------------------------------------
# Defaults follow the generic ZKTeco PUSH documentation and are UNVERIFIED
# for the MB10-VL. Change them only from evidence gathered with
# docs/PROTOCOL_NOTES.md, then set ADMS_PROFILE_VERIFIED=true.
ADMS_PROFILE_NAME=zk-push-generic
ADMS_PROFILE_VERIFIED=false
ADMS_ACK_STYLE=ok                 # ok -> "OK" ; ok_count -> "OK: <n>"
ADMS_LINE_ENDING=lf               # lf | crlf
ADMS_TRANS_FLAG=1111000000
ADMS_DEVICE_TZ_HOURS=8            # UTC+8 for Asia/Manila
ADMS_EXTRA_OPTIONS=               # extra handshake lines, "Key=Value;Key2=Value2"
ADMS_ENABLE_COMMANDS=false        # leave off until command support is verified
ADMS_LOG_HEARTBEATS=false         # set true while verifying a new device
ADMS_COMM_LOG_RETENTION_DAYS=30
ADMS_RATE_LIMIT_PER_MIN=300

# --- Backups ---------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
